---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Island from '../components/island/Island.astro';
import Chapter from '../components/Chapter.astro';
import Features from '../components/Features.astro';
import Mascot from '../components/Mascot.astro';
import FAQ from '../components/FAQ.astro';
import Glance from '../components/Glance.astro';
import Download from '../components/Download.astro';
import { Footer } from '../components/Footer';

const lang = 'pl';
---

<BaseLayout
  title="白アニ · ShiroAni — przeglądarka i tracker anime"
  titleKey="meta.home.title"
  descriptionKey="meta.home.description"
  lang={lang}
>
  <Navbar lang={lang} />
  <main id="main">
    <Island lang={lang} />

    <Chapter
      id="funkcje"
      lang={lang}
      num="01"
      eyebrow="Chapter one · Poza wyspą"
      title="I jeszcze "
      em="kilka rzeczy"
      titleSuffix="."
      meta="5 funkcji<br />№ 05 do 09"
      eyebrowKey="chapter.01.eyebrow"
      titleKey="chapter.01.title"
      emKey="chapter.01.em"
      titleSuffixKey="chapter.01.titleSuffix"
      metaKey="chapter.01.meta"
    />
    <Features lang={lang} />

    <Chapter
      id="maskotka"
      lang={lang}
      num="02"
      eyebrow="Chapter two · Mała towarzyszka"
      title="Poznaj "
      em="Shiro-chan"
      titleSuffix="."
      meta="8+ póz"
      eyebrowKey="chapter.02.eyebrow"
      titleKey="chapter.02.title"
      emKey="chapter.02.em"
      titleSuffixKey="chapter.02.titleSuffix"
      metaKey="chapter.02.meta"
    />
    <Mascot lang={lang} />

    <Chapter
      id="faq"
      lang={lang}
      num="03"
      eyebrow="Chapter three · Pytania"
      title="Krótko i "
      em="na temat"
      titleSuffix="."
      meta="6 pytań"
      eyebrowKey="chapter.03.eyebrow"
      titleKey="chapter.03.title"
      emKey="chapter.03.em"
      titleSuffixKey="chapter.03.titleSuffix"
      metaKey="chapter.03.meta"
    />
    <FAQ lang={lang} />

    <Glance lang={lang} />
    <Download lang={lang} />
  </main>
  <Footer client:visible lang={lang} />
</BaseLayout>
