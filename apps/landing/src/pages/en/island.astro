---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Island from '../../components/island/Island.astro';
import { Footer } from '../../components/Footer';

// Preview of the 3D landing. Kept out of search until it becomes the homepage.
const lang = 'en';
---

<BaseLayout
  title="白アニ · ShiroAni · an island under the moon"
  description="Your cozy corner for all things anime: an ad-free browser, library, airing schedule and diary in one free desktop app."
  titleKey="meta.island.title"
  descriptionKey="meta.island.description"
  lang={lang}
  noindex
>
  <Navbar lang={lang} />
  <main id="main">
    <Island lang={lang} />
  </main>
  <Footer client:visible lang={lang} />
</BaseLayout>
