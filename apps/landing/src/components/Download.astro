---
import { getReleases } from '../lib/releases';
import { localizedPath, t, type SupportedLanguage } from '../lib/i18n';

interface Props {
  /** Active SSR language. Defaults to PL; `/en/*` pages pass `lang="en"`. */
  lang?: SupportedLanguage;
}

const { lang = 'pl' } = Astro.props;
const tt = (key: string) => t(key, lang);
// Same target as the island's moon stop: the /download page picks the file.
// The button labels are the moon stop's too, so the two never drift apart.
const downloadHref = localizedPath(lang, '/download');
const latest = getReleases(lang)[0];
---

<section class="dl-line-wrap" id="pobierz">
  <div class="dl-line">
    <div class="dl-line-l">
      <h2 data-i18n="download.title">{tt('download.title')}</h2>
      <div class="minor">v{latest.version} · <span data-i18n="download.minor.released">{tt('download.minor.released')}</span> {latest.dateShort}</div>
    </div>
    <div class="dl-line-r">
      <a class="btn btn-primary" href={downloadHref}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3 5.5L10.5 4.2v8H3V5.5zm0 13L10.5 19.8v-8H3v6.7zM11.5 20l9.5 1.7V11.5h-9.5V20zM11.5 4l9.5-1.7v9.2h-9.5V4z"/>
        </svg>
        <span data-i18n="island.moon.windows">{tt('island.moon.windows')}</span>
      </a>
      <a class="btn btn-ghost" href={downloadHref}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.3 12.6c0-2.5 2-3.7 2.1-3.8-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.9-1.7 0-3.2 1-4 2.5-1.7 3-.4 7.4 1.2 9.9.8 1.2 1.8 2.5 3 2.4 1.2-.1 1.6-.8 3.1-.8 1.4 0 1.9.8 3.2.7 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.5-.9-2.5-3.8zM15 4.8c.7-.8 1.1-2 1-3.2-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.3-.6 2.9-1.3z"/>
        </svg>
        <span data-i18n="island.moon.macos">{tt('island.moon.macos')}</span>
      </a>
    </div>
  </div>
</section>
