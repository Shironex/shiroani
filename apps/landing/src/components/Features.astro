---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { BUILT_IN_THEME_METADATA, type BuiltInThemeMeta } from '@shiroani/shared';
import discordRpc from '../assets/discord_rpc.webp';
import onboarding from '../assets/onboarding.webp';
import { t, type SupportedLanguage } from '../lib/i18n';

interface Props {
  /** Active SSR language. Defaults to PL; `/en/*` pages pass `lang="en"`. */
  lang?: SupportedLanguage;
}

const { lang = 'pl' } = Astro.props;
const tt = (key: string) => t(key, lang);

// Single source of truth — same metadata that drives the theme swatch strip.
const themeCount = BUILT_IN_THEME_METADATA.length;
const darkThemeCount = BUILT_IN_THEME_METADATA.filter((m) => m.isDark).length;
const lightThemeCount = BUILT_IN_THEME_METADATA.filter((m) => !m.isDark).length;

type Feature = {
  cls: string;
  noKey: string;
  noFallback: string;
  tagKey?: string;
  tagFallback?: string;
  titleKey: string;
  titleFallback: string;
  descKey: string;
  descFallback: string;
  img?: ImageMetadata;
  altKey?: string;
  altFallback?: string;
  w?: number;
  h?: number;
  themes?: readonly BuiltInThemeMeta[];
};

const SHOT = { w: 3420, h: 2214 };
const RPC = { w: 1116, h: 378 };

// Only what the island tour doesn't already show (library, schedule, diary and
// browser live on its stops), so the numbering picks up at № 05. Two image
// cards on top; below, the tall themes card beside the two short text cards
// stacked, so every row fills the 12-column grid.
const features: Feature[] = [
  {
    cls: 'col-5 hl ft-rpc',
    noKey: 'features.05.no',
    noFallback: '№ 05 · DISCORD RPC',
    tagKey: 'features.05.tag',
    tagFallback: 'TEMPLATE EDITOR',
    titleKey: 'features.05.title',
    titleFallback: 'Pokaż znajomym, co oglądasz.',
    descKey: 'features.05.desc',
    descFallback:
      'Rich Presence z własnym szablonem. Podgląd na żywo w ustawieniach. Edytujesz tekst, obrazki, akcje.',
    img: discordRpc,
    altKey: 'features.05.alt',
    altFallback: 'Discord Rich Presence',
    ...RPC,
  },
  {
    cls: 'col-7 hl',
    noKey: 'features.06.no',
    noFallback: '№ 06 · NEW TAB',
    titleKey: 'features.06.title',
    titleFallback: 'Ulubione strony pod jednym kliknięciem.',
    descKey: 'features.06.desc',
    descFallback: 'Kafelki szybkiego dostępu. Raz skonfigurujesz, masz na zawsze.',
    img: onboarding,
    altKey: 'features.06.alt',
    altFallback: 'Nowa karta',
    ...SHOT,
  },
  {
    cls: 'col-4 ft-themes',
    noKey: 'features.07.no',
    noFallback: '№ 07 · THEMES',
    titleKey: 'features.07.title',
    titleFallback: `${themeCount} motywów plus edytor własnych.`,
    descKey: 'features.07.desc',
    descFallback: `${darkThemeCount} ciemnych, ${lightThemeCount} jasne, większość inspirowana anime. Wizualny edytor palety, czcionek i tła.`,
    themes: BUILT_IN_THEME_METADATA,
  },
  {
    cls: 'col-8 ft-short',
    noKey: 'features.08.no',
    noFallback: '№ 08 · NOTIFICATIONS',
    titleKey: 'features.08.title',
    titleFallback: 'Nowy odcinek? Jesteś pierwszy.',
    descKey: 'features.08.desc',
    descFallback:
      'Powiadomienia systemowe, gdy tylko któraś seria z biblioteki dostaje nowy odcinek.',
  },
  {
    cls: 'col-8 ft-short',
    noKey: 'features.09.no',
    noFallback: '№ 09 · IMPORT / EXPORT',
    titleKey: 'features.09.title',
    titleFallback: 'Twoje dane należą do Ciebie.',
    descKey: 'features.09.desc',
    descFallback:
      'Lokalne SQLite. Import i eksport biblioteki i pamiętnika jednym kliknięciem. Bez chmury, bez konta.',
  },
];
---

<section class="features">
  <div class="fgrid">
    {features.map((f) => (
      <article class={`fc ${f.cls}`}>
        <div class="fc-head">
          <span class="no" data-i18n={f.noKey}>{tt(f.noKey)}</span>
          {f.tagKey && <span class="tag" data-i18n={f.tagKey}>{tt(f.tagKey)}</span>}
        </div>
        <h3 data-i18n={f.titleKey}>{tt(f.titleKey)}</h3>
        <p data-i18n={f.descKey}>{tt(f.descKey)}</p>
        {f.img && (
          <div class="fimg">
            <Image
              src={f.img}
              alt={f.altKey ? tt(f.altKey) : (f.altFallback ?? '')}
              data-i18n-alt={f.altKey}
              loading="lazy"
              decoding="async"
              width={f.w}
              height={f.h}
              widths={[480, 800, 1400]}
              sizes="(max-width: 1100px) 92vw, (max-width: 1440px) 50vw, 720px"
            />
          </div>
        )}
        {f.themes && (
          <div class="fthemes" aria-hidden="true">
            <div class="fthemes-row" data-group="dark">
              {f.themes.filter((t) => t.isDark).map((t) => (
                <div
                  class="fthemes-sw"
                  title={t.label}
                  style={`--sw-bg: oklch(0.12 0.018 300); --sw-fg: ${t.color};`}
                >
                  <span class="fthemes-lbl">{t.label}</span>
                </div>
              ))}
            </div>
            <div class="fthemes-row" data-group="light">
              {f.themes.filter((t) => !t.isDark).map((t) => (
                <div
                  class="fthemes-sw is-light"
                  title={t.label}
                  style={`--sw-bg: oklch(0.97 0.008 80); --sw-fg: ${t.color};`}
                >
                  <span class="fthemes-lbl">{t.label}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </article>
    ))}
  </div>
</section>
